[Unit]
Description=Nyx Notification Center services (for its Quickshell interface)
After=graphical-session.target nyx-notifyd.service
Wants=nyx-notifyd.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nyx-notification-center-backend
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
